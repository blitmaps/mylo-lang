<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <!-- Added the id "window_main" -->
  <object class="GtkWindow" id="window_main">
    <property name="can-focus">False</property>
    <property name="default-width">300</property>
    <property name="default-height">200</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">20</property>
        <child>
          <!-- Added the id "txt_input" -->
          <object class="GtkEntry" id="txt_input">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="placeholder-text">Enter your name...</property>
          </object>
        </child>
        <child>
          <!-- Added the id "btn_submit" -->
          <object class="GtkButton" id="btn_submit">
            <property name="label">Submit</property>
            <property name="visible">True</property>
            <property name="can-focus">True</property>
          </object>
        </child>
        <child>
          <!-- Added the id "lbl_output" -->
          <object class="GtkLabel" id="lbl_output">
            <property name="visible">True</property>
            <property name="label">Awaiting input...</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
