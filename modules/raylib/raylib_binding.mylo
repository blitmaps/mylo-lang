import C "raylib.h"

mod RL {

    struct RGB {
        var r : byte
        var g : byte
        var b : byte
    }

    struct Vector2 {
        var x : num
        var y : num
    }
    
    // Colours
    
    var RED : RGB = {r=255, g=0, b=0}
    var GREEN : RGB = {r=0, g=255, b=0}
    var BLUE : RGB = {r=0, g=0, b=255}
    var WHITE : RGB = {r=255, g=255, b=255}
    var YELLOW : RGB = {r=255, g=255, b=0}
    var CYAN : RGB = {r=0, g=255, b=255}
    var BLACK : RGB = {r=0, g=0, b=0}
    var GRAY: RGB =  {r=128, g=128, b= 128}

    cfn InitWindow(x: i32, y: i32, name: str)
    cfn ToggleFullscreen()
    cfn MaximizeWindow()

    fn LoadImage(file: str) {
        var img_id: num = C(file:str=file) -> num {
            Image raw = LoadImage(file);
            return MYLO_STORE(raw, "Image");
        }
        ret img_id
    }

    fn LoadTextureFromImage(id: num) {
        var tex_id: num = C(id: num = id) -> num {
            Image *img = MYLO_RETRIEVE(id, Image, "Image");
    
            Texture2D tex = LoadTextureFromImage(*(img)); 
            if (img) {
                return MYLO_STORE(tex,"Texture2D");
            }
            return 0;
        }
        ret tex_id
    }

    fn LoadImageFromMemory(filetype: str, file_data: byte[]) {
        var filesize : i32 = len(file_data)
        var img_id: num = C(filetype: str = filetype, file_data: byte[] = file_data, filesize: i32 = filesize) -> num {        
            Image raw = LoadImageFromMemory(filetype, file_data, filesize);
            return MYLO_STORE(raw, "Image");
        }
        ret img_id
    }

    fn LoadRenderTexture(w: i32, h: i32) {
        var id:num = C(w: i32 = w, h: i32 = h) -> num {
            RenderTexture2D target = LoadRenderTexture(w, h);
            return MYLO_STORE(target, "RenderTexture2D");
        }
        ret id
    }

    fn BeginTextureMode(id: num) {
        C(id : num = id) {
            RenderTexture2D *t = MYLO_RETRIEVE(id, RenderTexture2D, "RenderTexture2D");
            BeginTextureMode(*(t));
        }
    }
    
    cfn EndTextureMode()
    
    fn RenderTextureFullscreen(id: num, tex_w: i32, tex_h: i32) {
        C(id : num = id, tex_w: i32 = tex_w, tex_h : i32 = tex_h) {
            float a = (float)GetScreenWidth()/tex_w;
            float b = (float)GetScreenHeight()/tex_h;
            float scale = ((a)<(b)? (a) : (b));
            RenderTexture2D *target = MYLO_RETRIEVE(id, RenderTexture2D, "RenderTexture2D");
            DrawTexturePro(target->texture, (Rectangle){ 0.0f, 0.0f, (float)target->texture.width, (float)-target->texture.height },
                           (Rectangle){ (GetScreenWidth() - ((float)tex_w*scale))*0.5f, (GetScreenHeight() - ((float)tex_h*scale))*0.5f,
                           (float)(tex_w)*scale, (float)(tex_h)*scale }, (Vector2){ 0, 0 }, 0.0f, WHITE);

        }
    }

    fn LoadFontFromMemory(filetype: str, file_data: byte[], font_size: i32) {
        var filesize : i32 = len(file_data)
        var font_id: num = C(filetype: str = filetype, file_data: byte[] = file_data, filesize: i32 = filesize, font_size: i32 = font_size) -> num {
            Font f = LoadFontFromMemory(filetype, file_data, filesize, font_size, NULL, 250);
            return MYLO_STORE(f, "Font");
        }
        ret font_id
    }
    
    fn DrawTextEx(id: num, text: str, x: num, y: num, size: num, spacing: num, tint: RGB) {
            C(id:num = id, text: str = text, x:num = x, y:num =y, size: num = size, spacing: num=spacing, rgb: RL_RGB = tint) {                                                                                  
                Color c = {rgb->r, rgb->g, rgb->b, 255};
                Font *t = MYLO_RETRIEVE(id, Font, "Font");
                DrawTextEx(*(t), text, (Vector2){x, y}, size, 0, c); 
            }
    }
    
    fn DrawTexture(id: num, x: num, y: num, rgb: RGB) {
        C(id: num = id, x: num = x, y: num = y, rgb: RL_RGB = rgb) {
            // define our shading colour for draw texture
            Color c = {rgb->r, rgb->g, rgb->b, 255};
            // Grab our texture
            Texture2D *t = MYLO_RETRIEVE(id, Texture, "Texture2D");
            
            // Draw the texture
            DrawTexture(*(t), x, y, c);
        }
    }

    fn DrawCircle(x: i32, y: i32, r: i32, col: RGB) {
        C(r: i32 = r, x:i32 = x, y: i32 = y, rgb: RL_RGB = col) {
            Color c = {rgb->r, rgb->g, rgb->b, 255};
            DrawCircle(x, x, r, c);
        }
    }

    fn DrawCircleLines(x: i32, y: i32, r: i32, col: RGB) {
        C(r: i32 = r, x:i32 = x, y: i32 = y, rgb: RL_RGB = col) {
            Color c = {rgb->r, rgb->g, rgb->b, 255};
            DrawCircleLines(x, x, r, c);
        }
    }

    fn DrawRectangle(x: i32, y: i32, w: i32, h: i32, col: RGB) {
        C(x:i32 = x, y: i32 = y, w:i32 = w, h: i32 = h, rgb: RL_RGB = col) {
            Color c = {rgb->r, rgb->g, rgb->b, 255};
            DrawRectangle(x, y, w, h, c);
        }
    }
    
    fn DrawRectangleRounded(x: i32, y: i32, w: i32, h: i32, roundness: f32, col: RGB) {
        C(x:i32 = x, y: i32 = y, w:i32 = w, h: i32 = h, roundness: f32 = roundness, rgb: RL_RGB = col) {
            Color c = {rgb->r, rgb->g, rgb->b, 255};
            Rectangle r = {x, y, w, h};
            DrawRectangleRounded(r, roundness, 10, c);
        }
    }

    fn DrawRectangleRoundedLines(x: i32, y: i32, w: i32, h: i32, roundness: f32, col: RGB) {
        C(x:i32 = x, y: i32 = y, w:i32 = w, h: i32 = h, roundness: f32 = roundness, rgb: RL_RGB = col) {
            Color c = {rgb->r, rgb->g, rgb->b, 255};
            Rectangle r = {x, y, w, h};
            DrawRectangleRoundedLines(r, roundness, 10, c);
        }
    }

    fn DrawRectangleLines(x: i32, y: i32, w: i32, h: i32, col: RGB) {
        C(x:i32 = x, y: i32 = y, w:i32 = w, h: i32 = h, rgb: RL_RGB = col) { 
            Color c = {rgb->r, rgb->g, rgb->b, 255};
            DrawRectangleLines(x, y, w, h, c);
        }
    }

    fn DrawTriangle(top: Vector2, left: Vector2, right: Vector2, col: RGB) {
        C(top:RL_Vector2 = top, left:RL_Vector2 = left, right:RL_Vector2 = right, rgb: RL_RGB = col) { 
            Color co = {rgb->r, rgb->g, rgb->b, 255};
            Vector2 a = {top->x, top->y};
            Vector2 b = {left->x, left->y};
            Vector2 c = {right->x, right->y};
            DrawTriangle(a,b,c,co);
        }
    }
    
    fn DrawTriangleLines(top: Vector2, left: Vector2, right: Vector2, col: RGB) {
        C(top:RL_Vector2 = top, left:RL_Vector2 = left, right:RL_Vector2 = right, rgb: RL_RGB = col) { 
            Color co = {rgb->r, rgb->g, rgb->b, 255};
            Vector2 a = {top->x, top->y};
            Vector2 b = {left->x, left->y};
            Vector2 c = {right->x, right->y};
            DrawTriangleLines(a,b,c,co);
        }
    }
    
    cfn WindowShouldClose() -> num

    fn ClearBackground(col : RGB) {
        C(rgb: RL_RGB = col) {
            Color co = {rgb->r, rgb->g, rgb->b, 255};
            ClearBackground(co);
        }
    }
    
    cfn BeginDrawing()
    cfn EndDrawing()
    cfn DrawFPS(x: num, y: num)

}
